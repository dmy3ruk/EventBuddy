{
  "expo": {
    "name": "eventBuddy",
    "slug": "eventBuddy",
    "version": "1.0.0",
    "extra": {
      "cloudinaryCloudName": "process.env.EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME",
      "cloudinaryUploadPreset": "process.env.EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET",
      "router": {},
      "eas": {
        "projectId": "643f517e-fd55-4c5d-93d7-101c7580e791"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventbuddy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.eventBuddy",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": [
        "applinks:eventbuddy-81cbc.firebaseapp.com"
      ]
    },
    "android": {
      "package": "com.alinadmytruk.eventbuddy",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "dmy3ruk"
  }
}
